# cpp - C Preprocessor
#
# Builds the preprocessor that produces .x and .i files

# Disable built-in lex rule (.x -> .c) to avoid conflicts with lexeme output files
%.c: %.x

DEST ?= $(CURDIR)/../../root

CC = gcc

CCC = $(DEST)/bin/ccc
OUTDIR = stage1

ifdef TRACE
SETX = set -x
else
SETX = @ true
endif

# Compiler-specific flags
ifeq ($(CC),gcc)
WARNS = -Wall -Werror -pedantic \
-Wdeclaration-after-statement -Werror=declaration-after-statement \
-Werror=implicit-function-declaration
CFLAGS = -m32 -std=c89 -g -O0 $(WARNS)
else ifeq ($(CC),ccc)
CFLAGS = -DCCC
endif

INC = -I../../libsrc/include
SRCS = cpp.c lex.c io.c macro.c kw.c emit.c util.c kwtab.c knr.c
OBJS = $(SRCS:.c=.o)
GENERATED = kwtab.c

all: cpp xdump

cpp: $(OBJS)
	$(CC) $(CFLAGS) -o cpp $(OBJS)

xdump: xdump.c
	$(CC) $(CFLAGS) -o xdump xdump.c

# Generate skip-optimized keyword table
mkkw: mkkw.c
	$(CC) -o mkkw mkkw.c

kwtab.c: mkkw
	@echo "/* Auto-generated by mkkw - do not edit */" > kwtab.c
	@echo '#include "cpp.h"' >> kwtab.c
	@echo '#define HI 0x80' >> kwtab.c
	./mkkw >> kwtab.c

%.o: %.c cpp.h
	$(CC) $(CFLAGS) -c -o $@ $<

# Stage: compile with cross ccc to Z80 .o files
stage1:
	mkdir -p $(OUTDIR)
	@for f in $(SRCS); do \
	  b=$${f%.c}; \
	  printf "%-20s" "$$f: "; \
	  $(CCC) -DCCC -k -P -s $$f 2> $(OUTDIR)/$$b.err 1>&2 && { echo "ok"; rm -f $(OUTDIR)/$$b.err; } || echo "FAIL"; \
      mv $$b.i $$b.x $$b.1 $$b.2 $$b.pp $$b.s $$b.o $(OUTDIR) 2>/dev/null ; \
	done

# Compile with zc3 to check Z80 sizes
sizecheck: $(GENERATED)
	mkdir -p sizecheck
	$(SETX) ; o="" ; for f in $(SRCS); do \
		b=$${f%.c}; \
		o="$$o sizecheck/$$b.o" ; \
		printf "%-12s" "$$b: " ; \
		zc3 -S -DCCC $(INC) $$f && mv $$b.as sizecheck ; \
		zc3 -c -DCCC $(INC) -o sizecheck/$$b.o $$f && \
		{ echo "ok"; } || { echo "FAIL"; } \
	done ; \
	wssize $$o | awk '{t+=$$1;d+=$$2;b+=$$3;a+=$$4} END {print t,d,b,a}' | tee -a sizefile

clean:
	rm -f *.o *.1 *.2 *.x *.i *.pp

clobber: clean
	rm -f cpp mkkw kwtab.c xdump sizefile
	rm -rf stage1 stage2 sizecheck sizecheck1

install: cpp xdump
	cp cpp xdump $(DEST)/bin

.PHONY: all clean clobber install stage1 sizefile sizecheck
