#
# Makefile for ccc preprocessor
#

# Disable built-in lex rule (.x -> .c) to avoid conflicts with lexeme output files
%.c: %.x


include ../../GNUmakefile.inc

CC = gcc

LIBCCC = ../ccclib/libccc.a

ifeq ($(CC),gcc)
DEFINES = -DDEBUG
WARNS = -Wall -Werror -Wno-builtin-declaration-mismatch -Werror=declaration-after-statement
DEBUG = -g -O0
CFLAGS = -m32 -std=c89 $(DEBUG) $(DEFINES) $(WARNS) -I. -I../ccclib
LDFLAGS = -m32 $(DEBUG)
endif

INC = -I../include -I. -I../ccclib
CCC = $(HOSTDIR)/bin/ccc

ASTPP = ../astpp
C0 = ../pass1/c0
C1 = ../pass2/c1

OUTDIR = stage1

ifdef TRACE
SETX = set -x
else
SETX = @ true
endif

ifeq ($(CC),ccc)
CFLAGS = -I../include -I. -I../ccclib
endif

# Z80 compiler used by `sizecheck`.  ccc is the only one now; zc3
# was the Hi-Tech bootstrap.
ZCC = ccc
# -O, because -O is what ships.  A size report taken without the
# peephole measures a binary nobody builds, and it is the number that
# decides whether a pass fits.
ZCFLAGS = -O -DCCC $(INC)
ZCC_ASM = -s
ZCC_ASMEXT = s

#
# Where a size build lands.  Still keyed to $(ZCC): when there were
# two compilers, one shared directory meant whatever ran last won,
# and reading zc3's objects as ccc's was easy to do and hard to see.
#
SIZEDIR = sizecheck-$(ZCC)

SOURCES = cpp.c lex.c io.c macro.c kw.c emit.c util.c kwtab.c lexdata.c tdsrc.c cfold.c knr.c \
	norm.c filtutil.c
OBJECTS = $(SOURCES:.c=.o)

HEADERS = cpp.h debug.h

GENERATED = kwtab.c debug.h dbgtags.c

all: cpp xdump

# Generated file rules
mkkw: mkkw.c
	$(CC) -o mkkw mkkw.c

kwtab.c: mkkw
	@echo "/* Auto-generated by mkkw - do not edit */" > kwtab.c
	@echo '#include "cpp.h"' >> kwtab.c
	@echo '#define HI 0x80' >> kwtab.c
	./mkkw >> kwtab.c

dbgtags.c debug.h: ./makedebug.sh
	./makedebug.sh

# The compile itself is the default rule in GNUmakefile.inc; this
# just says what every object here depends on besides its source.
$(OBJECTS): $(HEADERS)

cpp: $(OBJECTS) $(LIBCCC)
ifeq ($(CC),gcc)
	$(CC) $(LDFLAGS) -o $@ $(OBJECTS) $(LIBCCC)
else
	ccc -o cpp $(OBJECTS) $(LIBCCC)
endif

$(LIBCCC):
	$(MAKE) -C ../ccclib

xdump: xdump.c
	$(CC) $(CFLAGS) -o xdump xdump.c

regen:
	rm -f $(GENERATED)
	$(MAKE) $(GENERATED)

# test/ has no Makefile of its own; runtest.sh and sweep.sh drop
# their .x/.i/.n/.out there and it is cleaned from here.
clean:
	rm -f $(OBJECTS) cpp $(GENERATED) $(CRUFT) $(CRUFTASM)
	rm -f test/*.x test/*.tok test/*.nam test/*.out test/*.err

clobber: clean
	rm -f ./cpp mkkw xdump $(CRUFTLOG)
	rm -rf $(CRUFTDIRS)

# Installed as pass0, which is the name the driver runs it by - it is
# the first pass, not the C preprocessor of a Unix, and it writes the
# lexed .x that c0 reads rather than preprocessed C.  The build product
# in this directory keeps the old name; only what the driver looks for
# has to agree.
install: cpp xdump man-install
	$(INSTALL) cpp $(HOSTDIR)/lib/pass0
	$(INSTALL) xdump $(HOSTDIR)/bin

# Stage1: run cpp, c0, and c1 on each source file
stage1: cpp
	mkdir -p $(OUTDIR)
	$(SETX) ; for f in $(SOURCES); do \
		b=$${f%.c}; \
		err=$(OUTDIR)/$$b.err ; \
		printf "%-12s" "$$b: "; \
		if ! ./cpp -DCCC $(INC) -p -o $(OUTDIR)/$$b $$f 2> $$err; then \
			echo "FAIL (cpp)"; \
		elif ! $(C0) $(OUTDIR)/$$b.x $(OUTDIR)/$$b.ast $(OUTDIR)/$$b.dat 2>> $$err; then \
			echo "FAIL (c0)"; \
		elif ! $(ASTPP) $(OUTDIR)/$$b.ast > $(OUTDIR)/$$b.pp 2>> $$err; then \
			echo "FAIL (astpp)"; \
		elif ! $(C1) $(OUTDIR)/$$b.ast $(OUTDIR)/$$b.dat $(OUTDIR)/$$b.s 2>> $$err; then \
			echo "FAIL (c1)"; \
		else \
			echo "ok"; \
		fi \
	done

sizecheck: $(GENERATED)
	mkdir -p $(SIZEDIR)
	$(SETX) ; export ROOTDIR=$(TOP) ; o="" ; for f in $(SOURCES); do \
		b=$${f%.c}; \
		err=$(SIZEDIR)/$$b.err ; \
		o="$$o $(SIZEDIR)/$$b.o" ; \
		printf "%-12s" "$$b: " ; \
		$(ZCC) $(ZCC_ASM) $(ZCFLAGS) $$f >$$err 2>&1 && mv $$b.$(ZCC_ASMEXT) $(SIZEDIR) ; \
		$(ZCC) -c $(ZCFLAGS) $$f >>$$err 2>&1 && mv $$b.o $(SIZEDIR)/$$b.o && \
		{ echo "ok"; } || { echo "FAIL"; } \
	done ; \
	$(SIZE) $$o | awk '{t+=$$1;d+=$$2;b+=$$3;a+=$$4} END {print t,d,b,a}' | tee -a sizefile ; \
	$(LD) -r -o $(SIZEDIR)/cpp $(MXDIR)/lib/crt0.o $$o -L$(MXDIR)/lib -lccc -lc -lu ; \
	$(SIZE) $(SIZEDIR)/cpp | tee -a sizefile


# ---- native memory footprint ------------------------------------
#
#   mx-ccc    the self-build: ccc's own chain compiles cpp, linked
#             as a Micronix binary for the simulator.  This is the
#             cpp the self-build differential runs.
#
# com-zc3 built the same image with Hi-Tech C, and com-sdcc with
# sdcc, back when a second and third compiler's numbers were worth
# their upkeep as a check on ccc's.  Both are gone with the
# bootstrap.

CPPDIR   = $(abspath .)
LIBDIR   = $(abspath ../ccclib)
LIBSRCINC = $(abspath ../include)

# The peephole is not optional.  It is a few percent of text on
# ccc-generated code - 610 bytes off cpp, 1109 off c0, 1665 off c1 -
# and the passes are close enough to the ceiling that a few percent is
# the difference between a source compiling on the Z80 and not.  Build
# it the way it is meant to run; CCCOPT=  turns it off for a
# differential.
CCCOPT = -O


# The same build done by ccc itself, mirroring pass1's mx-ccc: one
# object per source through the driver, linked for the simulator.
# CCCOPT=-O runs the peephole; the self-build differential compares
# this cpp.mx against the host cpp on every tree source.
mx-ccc: $(GENERATED)
	@mkdir -p mxccc
	@set -e; cd mxccc ; export PATH=$(HOSTDIR)/bin:$$PATH ; \
	for f in $(SOURCES); do \
		b=$${f%.c}; \
		printf "%-12s" "$$b: " ; \
		if $(CCC) $(CCCOPT) -c -DCCC -i$(LIBSRCINC) \
			-I$(CPPDIR) -I$(LIBDIR) $(CPPDIR)/$$f > $$b.log 2>&1 \
			&& [ -f $$b.o ]; then \
			echo ok; \
		else echo FAIL; cat $$b.log; exit 1; fi \
	done
	cd mxccc && $(LD) -s -o cpp.mx -Ttext=0x100 \
		$(MXDIR)/lib/crt0.o $$(ls *.o 2>/dev/null) \
		-L$(MXDIR)/lib -lccc -lc -lu -lc
	@$(SIZE) mxccc/cpp.mx

# Individual stage1 file rules
.SECONDARY:

$(C0):
	$(MAKE) -C ../pass1 c0

$(C1):
	$(MAKE) -C ../pass2 c1

$(ASTPP):
	$(MAKE) -C .. astpp

$(OUTDIR)/%.x $(OUTDIR)/%.tok: %.c $(HEADERS) cpp
	@mkdir -p $(OUTDIR)
	./cpp -DCCC $(INC) -p -o $(OUTDIR)/$* $<

$(OUTDIR)/%.ast $(OUTDIR)/%.dat: $(OUTDIR)/%.x $(C0)
	$(C0) $< $(OUTDIR)/$*.ast $(OUTDIR)/$*.dat

$(OUTDIR)/%.pp: $(OUTDIR)/%.ast $(ASTPP)
	$(ASTPP) $< > $@

$(OUTDIR)/%.s: $(OUTDIR)/%.ast $(OUTDIR)/%.dat $(C1)
	$(C1) $(OUTDIR)/$*.ast $(OUTDIR)/$*.dat $@

regression: cpp
	../../tests/regress.sh --filter ccc/cpp/ $(REGRESS_FLAGS)

# Memory hygiene: run the host cpp over its own sources under valgrind,
# failing on leaks (definite/possible) and invalid reads/writes.  Logs
# for failing files are kept in valgrind/<base>.vg.
valgrind: cpp
	@command -v valgrind > /dev/null || \
		{ echo "valgrind not installed"; exit 1; }
	@mkdir -p valgrind
	@status=0 ; for f in $(SOURCES); do \
		b=$${f%.c}; \
		printf "%-12s" "$$b: " ; \
		if valgrind --leak-check=full \
			--show-leak-kinds=definite,indirect \
			--track-origins=yes --error-exitcode=99 \
			--log-file=valgrind/$$b.vg \
			./cpp -DCCC $(INC) -o valgrind/$$b $$f > /dev/null 2>&1; then \
			echo "ok"; rm -f valgrind/$$b.vg; \
		else \
			echo "FAIL (valgrind/$$b.vg)"; \
			grep -m1 'ERROR SUMMARY' valgrind/$$b.vg /dev/null | \
				sed 's/^[^=]*==[0-9]*== */    /'; \
			status=1; \
		fi \
	done ; exit $$status

# Language conformance: run cpp over its own sources (self-compile check).
# Each source must be legal input per INPUT.md (validate_src), cpp must
# consume it, and the .x/.i output must be to-spec per OUTPUT.md for the
# subsequent passes (validate_x, validate_i).
langtest: cpp xdump
	@mkdir -p langtest
	@status=0 ; export PATH=.:$$PATH ; for f in $(SOURCES); do \
		b=$${f%.c}; \
		err=langtest/$$b.err ; \
		printf "%-12s" "$$b: "; \
		if ! python3 validate_src.py $$f > $$err 2>&1; then \
			echo "FAIL (src)"; status=1; \
		elif ! ./cpp -DCCC $(INC) -p -o langtest/$$b $$f 2>> $$err; then \
			echo "FAIL (cpp)"; status=1; \
		elif ! python3 validate_x.py langtest/$$b.x >> $$err 2>&1; then \
			echo "FAIL (x)"; status=1; \
		elif ! python3 validate_i.py langtest/$$b.tok >> $$err 2>&1; then \
			echo "FAIL (i)"; status=1; \
		else \
			echo "ok"; \
			grep '^warning:' $$err || true; \
			rm -f $$err; \
		fi \
	done ; \
	if [ $$status -ne 0 ]; then \
		echo "langtest FAILED - details in langtest/*.err" ; \
	fi ; \
	exit $$status

test: langtest
	cd test && ./runtest.sh
	cd test && ./sweep.sh

# The self-hosted pass, installed into destmicronix/lib under the
# name the driver runs it by - the compiler as it runs on the machine
# it targets.  A system root, not a pile of .mx files: bin/lib laid
# out the way Micronix wants them, so the tree can be copied straight
# onto a filesystem and used.
mx-install: mx-ccc
	@mkdir -p $(MXDIR)/lib
	$(INSTALL) mxccc/cpp.mx $(MXDIR)/lib/pass0

# The CP/M image.  Same sources, same driver, -m cpm: the runtime
# comes out of cpm/ instead of micronix/, crtcpm starts it, libcpm
# turns the calls into BDOS calls, and the driver strips the object
# header so what is left is what CP/M loads at 0x100.
com-ccc: $(GENERATED)
	@mkdir -p comccc
	@set -e; cd comccc ; \
	for f in $(SOURCES); do \
		b=$${f%.c}; \
		printf "%-12s" "$$b: " ; \
		if $(CCC) $(CCCOPT) -m cpm -c -DCCC -DCPM -i$(CPMDIR)/include \
			-I$(CPPDIR) -I$(LIBDIR) $(CPPDIR)/$$f > $$b.log 2>&1 \
			&& [ -f $$b.o ]; then \
			echo ok; \
		else echo FAIL; cat $$b.log; exit 1; fi \
	done
	cd comccc && $(CCC) -m cpm -S -o cpp.com $$(ls *.o 2>/dev/null) \
		-L$(CPMDIR)/lib -lccc > /dev/null
	@echo "cpp.com: `wc -c < comccc/cpp.com` bytes"

com-install: com-ccc
	@mkdir -p $(CPMDIR)/bin
	$(INSTALL) comccc/cpp.com $(CPMDIR)/bin

# The manual goes with what it documents.  man(1) on the target looks
# in /usr/man/man<n> - the path is in the binary - so the staged tree
# carries the pages under usr, the same as the headers.
#
# They live in man1/ rather than here, and have to: ".1" is pass1's
# AST suffix and is swept by CRUFT, so a page beside the source would
# be removed by the next "make clean".
MANPAGES = man1/pass0.1

man-install:
	@mkdir -p $(MXDIR)/usr/man/man1
	$(INSTALL) $(MANPAGES) $(MXDIR)/usr/man/man1

.PHONY: all clean regen stage1 install clobber sizefile sizecheck regression langtest test mx-ccc valgrind mx-install com-ccc com-install man-install

