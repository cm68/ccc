# Editors, IDEs, OS
.gdbargs
.settings
.cproject
.project
.idea
.nfs*
.claude/
.bashrc
.aider*
tags
*.swp
*~
*.orig
*.rej
.DS_Store
__pycache__/

# Compiler pass intermediates.  The passes chain
# .c -> .i (cpp text) -> .x (cpp lexemes) -> .1 (AST) + .2 (pass1 asm)
# -> .s/.as (asm) -> .o/.obj (object) -> binary
*.i
*.x
*.1
*.2
*.s
*.as
*.asm
*.o
*.obj
*.rel
*.a
*.ast
*.pp

# Linker and toolchain byproducts
*.lst
*.sym
*.map
*.mem
*.n
*.noi
*.lk
*.cdb
*.d
lib/*.O

# Z80/CP/M images
*.com
*.ws
*.bin
*.hex
*.ihx
*.mx

# Build logs, diagnostics and crash dumps
*.log
*.err
*.out
a.out
core
core.[0-9]*
vgcore.*
sizefile*
oldsize
tmp[0-9]*

# Generated build directories
stage1/
stage2/
z80/
sizecheck/
sizecheck-*/
sizecheck1/
langtest/
comzc3/
comsdcc/
mxzc3/
mxccc/
ccctest/
valgrind/
attic/

# The install trees.  Everything in them was put there by a build,
# and "make clobber" takes them away again.
unix/
micronix/
cpm/

# The simulator the runtime tests run under - a symlink to a build of
# it outside this tree, made by hand and pointing wherever it lives.
tests/sim

# Sources that share an extension with the intermediates above.
# The runtime's assembly lives one level under src - src/libc,
# src/libu and src/libcpm, the last two holding a startup file each -
# plus the assembler's own test cases.
!src/*/*.s
!src/tools/tests/*.s

# regress.sh baselines are checked in: .x lexeme dumps, .rc exit codes
# and .err stderr, all of which the rules above would otherwise hide.
!tests/baseline/**
